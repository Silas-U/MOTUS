<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ur5e_arm: kinematic + visual/collision/inertial chain only.
       No ros2_control, no gazebo plugin block — those live in
       ros2_control_macros.xacro so the same arm geometry can be
       reused across sim/real/rviz-only without duplication.

       prefix : string prepended to every link/joint name. Required
                for multi-arm scenes (two ur5e_arm calls in one URDF
                would otherwise collide on e.g. "shoulder_pan_joint").
       parent : link this arm's base_link is fixed to (e.g. "world",
                or a mount-plate link in a multi-arm cell).
       *origin : xacro block param — the <origin> of the fixed joint
                attaching base_link to parent. Lets a multi-arm cell
                place each arm at a different pose on the same parent. -->
  <xacro:macro name="ur5e_arm" params="prefix parent *origin">

    <xacro:property name="mesh_pkg" value="robokpy_controller"/>

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link"/>
    <link name="${prefix}base_link_inertia">
      <visual>
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/base.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.0"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
      </inertial>
    </link>
    <link name="${prefix}shoulder_link">
      <visual>
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/shoulder.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/shoulder.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.761"/>
        <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.00193 -0.02561"/>
        <inertia ixx="0.0070021" ixy="7.3e-07" ixz="-1.053e-05" iyy="0.00648091" iyz="0.00049994" izz="0.00657286"/>
      </inertial>
    </link>
    <link name="${prefix}upper_arm_link">
      <visual>
        <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.138"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/upperarm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.138"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/upperarm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="8.058"/>
        <origin rpy="0 0 0" xyz="-0.2125 0.0 0.11336"/>
        <inertia ixx="0.01505885" ixy="-5.4e-05" ixz="5.63e-06" iyy="0.33388086" iyz="-1.81e-06" izz="0.33247207"/>
      </inertial>
    </link>
    <link name="${prefix}forearm_link">
      <visual>
        <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.007"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/forearm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.007"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/forearm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.846"/>
        <origin rpy="0 0 0" xyz="-0.2422 0.0 0.0265"/>
        <inertia ixx="0.00399632" ixy="-1.365e-05" ixz="0.00137272" iyy="0.07879254" iyz="-6.6e-06" izz="0.0784851"/>
      </inertial>
    </link>
    <link name="${prefix}wrist_1_link">
      <visual>
        <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.127"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.127"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.37"/>
        <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018"/>
        <inertia ixx="0.00165491" ixy="-2.82e-06" ixz="-4.38e-06" iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
      </inertial>
    </link>
    <link name="${prefix}wrist_2_link">
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.3"/>
        <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018"/>
        <inertia ixx="0.00135617" ixy="-2.74e-06" ixz="4.44e-06" iyy="0.00127827" iyz="-5.048e-05" izz="0.00096614"/>
      </inertial>
    </link>
    <link name="${prefix}wrist_3_link">
      <visual>
        <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
        <geometry>
          <mesh filename="package://ur5e_real_test_motus/meshes/wrist3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.365"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
        <inertia ixx="0.00018694" ixy="6e-08" ixz="-1.7e-07" iyy="0.00018908" iyz="-9.2e-07" izz="0.00025756"/>
      </inertial>
    </link>

    <joint name="${prefix}base_link-base_link_inertia" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base_link_inertia"/>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    </joint>
    <joint name="${prefix}shoulder_pan_joint" type="revolute">
      <parent link="${prefix}base_link_inertia"/>
      <child link="${prefix}shoulder_link"/>
      <origin rpy="0 0 0" xyz="0 0 0.1625"/>
      <axis xyz="0 0 1"/>
      <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>
    <joint name="${prefix}shoulder_lift_joint" type="revolute">
      <parent link="${prefix}shoulder_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}forearm_link"/>
      <origin rpy="0 0 0" xyz="-0.425 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>
    <joint name="${prefix}wrist_1_joint" type="revolute">
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist_1_link"/>
      <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
      <axis xyz="0 0 1"/>
      <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>
    <joint name="${prefix}wrist_2_joint" type="revolute">
      <parent link="${prefix}wrist_1_link"/>
      <child link="${prefix}wrist_2_link"/>
      <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11"/>
      <axis xyz="0 0 1"/>
      <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>
    <joint name="${prefix}wrist_3_joint" type="revolute">
      <parent link="${prefix}wrist_2_link"/>
      <child link="${prefix}wrist_3_link"/>
      <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
      <axis xyz="0 0 1"/>
      <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}ft_frame"/>
    <joint name="${prefix}wrist_3_link-ft_frame" type="fixed">
      <parent link="${prefix}wrist_3_link"/>
      <child link="${prefix}ft_frame"/>
      <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base_fixed_joint" type="fixed">
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <link name="${prefix}flange"/>
    <joint name="${prefix}wrist_3-flange" type="fixed">
      <parent link="${prefix}wrist_3_link"/>
      <child link="${prefix}flange"/>
      <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}tool0"/>
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <parent link="${prefix}flange"/>
      <child link="${prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
