# Request
float64[] q                # joint angles for active joints in chain (radians)
string base_link           # name of base link
string end_link            # name of end link

---

# Response
bool success
float64[7] pose            # [x, y, z, qx, qy, qz, qw]
float64[6] pose_euler      # [x, y, z, roll, pitch, yaw] in radians
string message
