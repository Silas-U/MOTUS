<?xml version="1.0"?>

<robot name="two_dof_robot">
    
    <material name="light_gray">
        <color rgba="0.73 0.73 0.73 1"/>
    </material>

    <material name="dark_gray">
        <color rgba="0.25 0.25 0.25 1"/>
    </material>

    <link name="world"/>
    <joint name="fixed_joint1" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>                                                                                           

    <link name="base_link">
        <visual>
            <geometry>
                    <cylinder length="0.2" radius="0.4"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="light_gray"/>
        </visual>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link" />
        <child link="link_1" />
        <origin  rpy="0 0 0" xyz="0 0 0.2"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1" />
    </joint>

    <link name="link_1">
        <visual>
            <geometry>
                    <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <joint name="fixed_joint2" type="fixed">
        <parent link="link_1" />
        <child link="fixed_link2" />
        <origin  rpy="0 -1.57 0" xyz="0 0 0.4"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fixed_link2">
        <visual>
            <geometry>
                    <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <joint name="joint_2" type="revolute">
        <parent link="fixed_link2" />
        <child link="link_2" />
        <origin rpy="0 0 0" xyz="0 0 0.4"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="link_2">
        <visual>
            <geometry>
                    <cylinder length="2.0" radius="0.2"/>
            </geometry>
            <origin xyz="1.0 0 0" rpy="0 1.57 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

     <joint name="fixed_joint3" type="fixed">
        <parent link="link_2" />
        <child link="fixed_link3" />
        <origin rpy="0 1.57 0" xyz="1.8 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="fixed_link3">
        <visual>
            <geometry>
                    <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <origin xyz="0.3 0 0" rpy="0 1.57 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="fixed_link3" />
        <child link="link_3" />
        <origin rpy="0 1.57 0" xyz="0.4 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="link_3">
        <visual>
            <geometry>
                    <cylinder length="1.5" radius="0.2"/>
            </geometry>
            <origin xyz="-0.75 0 0" rpy="0 1.57 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>


    <joint name="joint_4" type="revolute">
        <parent link="link_3" />
        <child link="link_4" />
        <origin rpy="0 1.57 0" xyz="-1.7 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="link_4">
        <visual>
            <geometry>
                     <box size="0.2 0.4 0.4"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <joint name="joint_5" type="revolute">
        <parent link="link_4" />
        <child link="link_5" />
        <origin rpy="0 1.57 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="link_5">
        <visual>
            <geometry>
                    <cylinder length="0.4" radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <joint name="joint_6" type="revolute">
        <parent link="link_5" />
        <child link="link_6" />
        <origin rpy="0 1.57 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1" />
    </joint>

    <link name="link_6">
        <visual>
            <geometry>
                    <cylinder length="0.4" radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    
    <joint name="tool_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin rpy="0 0 0" xyz="0 0 0.4"/>
    <axis xyz="0 0 1"/>
    </joint>

    <link name="tool0"/>

     <ros2_control name="GazeboSystem" type="system">
   
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
 
    <joint name="joint_1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_6">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <sensor name="tcp_fts_sensor">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <sensor name="tcp_pose">
      <state_interface name="position.x"/>
      <state_interface name="position.y"/>
      <state_interface name="position.z"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
    </sensor>
  </ros2_control>
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>CONTROLLERS_YAML_PATH</parameters>
      </plugin>
    </gazebo>

</robot>
