    </collision>
    <inertial>
      <mass value="1.37"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018"/>
      <inertia ixx="0.00165491" ixy="-2.82e-06" ixz="-4.38e-06" iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
    </inertial>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/ur5e/visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/ur5e/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.3"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018"/>
      <inertia ixx="0.00135617" ixy="-2.74e-06" ixz="4.44e-06" iyy="0.00127827" iyz="-5.048e-05" izz="0.00096614"/>
    </inertial>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/ur5e/visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/ur5e/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.365"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
      <inertia ixx="0.00018694" ixy="6e-08" ixz="-1.7e-07" iyy="0.00018908" iyz="-9.2e-07" izz="0.00025756"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>

  <!-- =========================================================
       ROBOTIQ 2F-85 GRIPPER
       Ported from the ROS1 robotiq_gripper description, mounted
       directly to tool0 (fixed joint). Meshes extracted (unrenamed)
       into robokpy_controller/meshes/robotiq_85_gripper_meshes/.

       FIXES applied vs. the original ROS1 source:
       - left_finger_joint / right_finger_joint were missing <limit>
         and <mimic> entirely -> unconstrained continuous DOF, free-
         spinning in Gazebo. Added limit + mimic(multiplier=1) so
         they track the primary knuckle instead of floating.
       - Dropped the ROS1 <transmission> tag entirely; actuation is
         handled below in <ros2_control>, same pattern as the
         primitive 2-finger gripper (primary = effort command
         interface, all mimics = state interfaces only).
       - Non-standard inertia attributes (iyx/izx/izy, duplicates of
         ixy/ixz/iyz) removed — URDF only reads ixx/ixy/ixz/iyy/iyz/izz.
       ========================================================= -->

  <!-- robotiq_85_base_link's approach axis is its local +X (knuckle
       joints offset in X/Y, Z is the rotation axis); tool0's approach
       axis is +Z. Rotate -90 deg about Y to align local X -> tool0 Z.
       If the gripper still looks off after this (e.g. fingers pointing
       backward toward the wrist), flip the sign to +1.5707963267948966. -->
  <joint name="tool0_to_robotiq_85_base_joint" type="fixed">
    <origin rpy="0 -1.5707963267948966 0" xyz="0 0 0"/>
    <parent link="tool0"/>
    <child link="robotiq_85_base_link"/>
  </joint>

  <link name="robotiq_85_base_link">
    <visual>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_base_link.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.636951"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000380" ixy="0.000000" ixz="0.000000" iyy="0.001110" iyz="0.000000" izz="0.001171"/>
    </inertial>
  </link>

  <joint name="robotiq_85_left_knuckle_joint" type="revolute">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_left_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="3.14159 0.0 0.0" xyz="0.05490451627 0.03060114443 0.0"/>
    <limit lower="0.0" upper="0.804" velocity="2.0" effort="1000"/>
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <joint name="robotiq_85_right_knuckle_joint" type="continuous">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_right_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.05490451627 -0.03060114443 0.0"/>
    <limit lower="-3.14" upper="3.14" velocity="100.0" effort="1000"/>
    <mimic joint="robotiq_85_left_knuckle_joint"/>
  </joint>

  <link name="robotiq_85_left_knuckle_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_knuckle_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_knuckle_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.018491"/>
      <origin xyz="0.0 0.0 0.0"/>
      <!-- ixx bumped 0.000009 -> 0.000010: original ixx+iyy exactly equaled
           izz, a degenerate (planar) edge case of the principal-moment
           triangle inequality that RViz's inertia-box check rejects.
           Negligible physical change, resolves the warning. -->
      <inertia ixx="0.000010" ixy="-0.000001" ixz="0.000000" iyy="0.000001" iyz="0.000000" izz="0.000010"/>
    </inertial>
  </link>

  <link name="robotiq_85_right_knuckle_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_knuckle_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_knuckle_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.018491"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000010" ixy="-0.000001" ixz="0.000000" iyy="0.000001" iyz="0.000000" izz="0.000010"/>
    </inertial>
  </link>

  <joint name="robotiq_85_left_finger_joint" type="continuous">
    <parent link="robotiq_85_left_knuckle_link"/>
    <child link="robotiq_85_left_finger_link"/>
    <origin xyz="-0.00408552455 -0.03148604435 0.0" rpy="0 0 0"/>
  </joint>

  <joint name="robotiq_85_right_finger_joint" type="continuous">
    <parent link="robotiq_85_right_knuckle_link"/>
    <child link="robotiq_85_right_finger_link"/>
    <origin xyz="-0.00408552455 -0.03148604435 0.0" rpy="0 0 0"/>
  </joint>

  <link name="robotiq_85_left_finger_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_finger_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_finger_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.027309"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000003" ixy="-0.000002" ixz="0.000000" iyy="0.000021" iyz="0.000000" izz="0.000020"/>
    </inertial>
  </link>

  <link name="robotiq_85_right_finger_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_finger_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_finger_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.027309"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000003" ixy="-0.000002" ixz="0.000000" iyy="0.000021" iyz="0.000000" izz="0.000020"/>
    </inertial>
  </link>

  <joint name="robotiq_85_left_inner_knuckle_joint" type="continuous">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_left_inner_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.06142 0.0127 0" rpy="3.14159 0.0 0.0"/>
    <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
    <mimic joint="robotiq_85_left_knuckle_joint" offset="0"/>
  </joint>

  <joint name="robotiq_85_right_inner_knuckle_joint" type="continuous">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_right_inner_knuckle_link"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.06142 -0.0127 0" rpy="0 0 0"/>
    <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
    <mimic joint="robotiq_85_left_knuckle_joint" offset="0"/>
  </joint>

  <link name="robotiq_85_left_inner_knuckle_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_inner_knuckle_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_inner_knuckle_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.029951"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000039" ixy="0.000000" ixz="0.000000" iyy="0.000005" iyz="0.000000" izz="0.000035"/>
    </inertial>
  </link>

  <link name="robotiq_85_right_inner_knuckle_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_inner_knuckle_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_inner_knuckle_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.029951"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000039" ixy="0.000000" ixz="0.000000" iyy="0.000005" iyz="0.000000" izz="0.000035"/>
    </inertial>
  </link>

  <joint name="robotiq_85_left_finger_tip_joint" type="continuous">
    <parent link="robotiq_85_left_inner_knuckle_link"/>
    <child link="robotiq_85_left_finger_tip_link"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.04303959807 -0.03759940821 0.0" rpy="0.0 0.0 0.0"/>
    <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
    <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>

  <joint name="robotiq_85_right_finger_tip_joint" type="continuous">
    <parent link="robotiq_85_right_inner_knuckle_link"/>
    <child link="robotiq_85_right_finger_tip_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.04303959807 -0.03759940821 0.0"/>
    <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
    <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>

  <link name="robotiq_85_left_finger_tip_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_finger_tip_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_finger_tip_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.019555"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000002" ixy="0.000000" ixz="0.000000" iyy="0.000005" iyz="0.000000" izz="0.000006"/>
    </inertial>
  </link>

  <link name="robotiq_85_right_finger_tip_link">
    <visual>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/visual/robotiq_85_finger_tip_link.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robokpy_controller/meshes/robotiq_85_gripper_meshes/collision/robotiq_85_finger_tip_link.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.019555"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.000002" ixy="0.000000" ixz="0.000000" iyy="0.000005" iyz="0.000000" izz="0.000006"/>
    </inertial>
  </link>

  <!-- TCP frame - pinch point of fully-open gripper, along base_link's local +X -->
  <link name="tcp"/>
  <joint name="robotiq_85_base_link-tcp" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="tcp"/>
    <origin rpy="0 1.5707963267948966 0" xyz="0.104 0 0"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.5697</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-2.0535</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.9318</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.4490</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <!-- =========================================================
         Robotiq 2F-85 — 8 joints total. Only the primary
         (left_knuckle_joint) has a command_interface (effort); the
         other 7 have state interfaces only and rely on native
         gz_ros2_control mimic joint support driven by the <mimic>
         tags above. Matches the pattern validated on the primitive
         2-finger gripper.
         ========================================================= -->
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.001</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_right_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_left_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_right_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_left_inner_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_right_inner_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_left_finger_tip_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_right_finger_tip_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <sensor name="tcp_fts_sensor">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <sensor name="tcp_pose">
      <state_interface name="position.x"/>
      <state_interface name="position.y"/>
      <state_interface name="position.z"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
    </sensor>
  </ros2_control>
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>CONTROLLERS_YAML_PATH</parameters>
        <!-- Was absent defaulted to 0.1. Per gz_ros2_control docs, the
             POSITION command interface is a first-order lag:
               joint_velocity = position_proportional_gain * position_error * update_rate
               T = 1 / (position_proportional_gain * update_rate)
             At update_rate=125 and gain=0.1, T=0.08s, giving a
             steady-state tracking error of velocity*T while following a
             moving setpoint matches the ~0.05 rad joint-0 error seen
             all session regardless of trajectory-side tuning (acc_limits,
             seam handling), since that error scales with velocity and
             this fixed constant, not with trajectory shape. Raised to
             0.5 (docs: keep <1.0 to avoid oscillation, <2.0 for
             stability) for a ~5x smaller lag.
             CAVEAT: arm_controller exports BOTH position and velocity
             command interfaces for these joints; gz_ros2_control's docs
             describe each interface's behavior independently and don't
             specify which dominates when both are active on the same
             joint. This gain only affects the position interface's
             internal P-loop if the velocity interface is what's
             actually driving the joint, this change may have little
             effect. Test and check whether the joint-0 tolerance error
             actually shrinks before assuming this was the full fix. -->
        <position_proportional_gain>0.5</position_proportional_gain>
      </plugin>
    </gazebo>
</robot>
