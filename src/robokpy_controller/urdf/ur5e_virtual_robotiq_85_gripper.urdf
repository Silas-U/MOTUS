<?xml version="1.0" ?>

<robot name="ur_robot">
  <!-- create link fixed to the "world" -->
  <link name="world"/>
  <link name="base_link"/>
  <link name="base_link_inertia">
    <visual>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://robokpy_controller/meshes/ur5e/visual/base.dae"/>
