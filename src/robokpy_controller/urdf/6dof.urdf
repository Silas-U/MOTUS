<?xml version="1.0"?>

<robot name="two_dof_robot">
    
    <!-- ========================================================== -->
<!-- Materials -->
<!-- ========================================================== -->

<material name="light_gray">
    <color rgba="0.73 0.73 0.73 1"/>
</material>

<material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1"/>
</material>

<!-- ========================================================== -->
<!-- World -->
<!-- ========================================================== -->

<link name="world"/>

<joint name="fixed_joint1" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- ========================================================== -->
<!-- Base -->
<!-- ========================================================== -->

<link name="base_link">

    <visual>
        <origin xyz="0 0 0.045"/>
        <geometry>
            <cylinder radius="0.09" length="0.09"/>
        </geometry>

        <material name="light_gray"/>
    </visual>

    <collision>
        <origin xyz="0 0 0.045"/>
        <geometry>
            <cylinder radius="0.085" length="0.09"/>
        </geometry>
    </collision>

    <inertial>

        <origin xyz="0 0 0.045"/>

        <mass value="4.0"/>

        <inertia
            ixx="0.018"
            ixy="0"
            ixz="0"
            iyy="0.018"
            iyz="0"
            izz="0.028"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- Joint 1 -->
<!-- ========================================================== -->

<joint name="joint_1" type="revolute">

    <parent link="base_link"/>
    <child link="link_1"/>

    <origin xyz="0 0 0.09" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="100"
        velocity="3.14"/>

    <dynamics damping="1.5" friction="0.2"/>

</joint>

<!-- ========================================================== -->
<!-- SHOULDER LINK -->
<!-- ========================================================== -->

<link name="link_1">

    <visual>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.055" length="0.16"/>
        </geometry>
        <material name="dark_gray"/>
    </visual>

    <collision>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.050" length="0.16"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0.08"/>
        <mass value="3.0"/>

        <inertia
            ixx="0.009"
            ixy="0"
            ixz="0"
            iyy="0.009"
            iyz="0"
            izz="0.003"/>
    </inertial>

</link>

<!-- ========================================================== -->
<!-- Rotate into horizontal shoulder frame -->
<!-- ========================================================== -->

<joint name="fixed_joint2" type="fixed">

    <parent link="link_1"/>
    <child link="fixed_link2"/>

    <origin xyz="0 0 0.16"
            rpy="0 -1.57079632679 0"/>

</joint>

<!-- ========================================================== -->
<!-- Shoulder Housing -->
<!-- ========================================================== -->

<link name="fixed_link2">

    <visual>
        <origin xyz="0.05 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.050"
                      length="0.10"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0.05 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.10"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0.05 0 0"/>

        <mass value="2.0"/>

        <inertia
            ixx="0.0035"
            ixy="0"
            ixz="0"
            iyy="0.0035"
            iyz="0"
            izz="0.0018"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- Shoulder Pitch Joint -->
<!-- ========================================================== -->

<joint name="joint_2" type="revolute">

    <parent link="fixed_link2"/>
    <child link="link_2"/>

    <origin xyz="0.10 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="100"
        velocity="3.14"/>

    <dynamics
        damping="1.2"
        friction="0.15"/>

</joint>

<!-- ========================================================== -->
<!-- UPPER ARM -->
<!-- ========================================================== -->

<link name="link_2">

    <visual>

        <origin xyz="0.2125 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.425"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0.2125 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.040"
                      length="0.425"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0.2125 0 0"/>

        <mass value="8.0"/>

        <inertia
            ixx="0.125"
            ixy="0"
            ixz="0"
            iyy="0.125"
            iyz="0"
            izz="0.007"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- ELBOW TRANSITION -->
<!-- ========================================================== -->

<joint name="fixed_joint3"
       type="fixed">

    <parent link="link_2"/>
    <child link="fixed_link3"/>

    <origin xyz="0.425 0 0"
            rpy="0 1.57079632679 0"/>

</joint>

<!-- ========================================================== -->
<!-- ELBOW HOUSING -->
<!-- ========================================================== -->

<link name="fixed_link3">

    <visual>

        <origin xyz="0.05 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.10"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0.05 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.040"
                      length="0.10"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0.05 0 0"/>

        <mass value="1.5"/>

        <inertia
            ixx="0.0025"
            ixy="0"
            ixz="0"
            iyy="0.0025"
            iyz="0"
            izz="0.0015"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- ELBOW JOINT -->
<!-- ========================================================== -->

<joint name="joint_3"
       type="revolute">

    <parent link="fixed_link3"/>
    <child link="link_3"/>

    <origin xyz="0.10 0 0"
            rpy="0 1.57079632679 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="100"
        velocity="3.14"/>

    <dynamics
        damping="1.0"
        friction="0.10"/>

</joint>

<!-- ========================================================== -->
<!-- FOREARM -->
<!-- ========================================================== -->

<link name="link_3">

    <visual>

        <origin xyz="-0.196 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.040"
                      length="0.392"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="-0.196 0 0"
                rpy="0 1.57079632679 0"/>

        <geometry>
            <cylinder radius="0.036"
                      length="0.392"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="-0.196 0 0"/>

        <mass value="4.5"/>

        <inertia
            ixx="0.060"
            ixy="0"
            ixz="0"
            iyy="0.060"
            iyz="0"
            izz="0.004"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- WRIST 1 JOINT -->
<!-- ========================================================== -->

<joint name="joint_4"
       type="revolute">

    <parent link="link_3"/>
    <child link="link_4"/>

    <!-- End of forearm -->
    <origin xyz="-0.392 0 0"
            rpy="0 1.57079632679 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="80"
        velocity="4.0"/>

    <dynamics
        damping="0.8"
        friction="0.08"/>

</joint>

<!-- ========================================================== -->
<!-- WRIST 1 -->
<!-- ========================================================== -->

<link name="link_4">

    <visual>

        <origin xyz="0 0 0"/>

        <geometry>
            <cylinder radius="0.050"
                      length="0.110"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0 0 0"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.110"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0 0 0"/>

        <mass value="1.20"/>

        <inertia
            ixx="0.0018"
            ixy="0"
            ixz="0"
            iyy="0.0018"
            iyz="0"
            izz="0.0012"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- WRIST 2 JOINT -->
<!-- ========================================================== -->

<joint name="joint_5"
       type="revolute">

    <parent link="link_4"/>
    <child link="link_5"/>

    <!-- Wrist center -->
    <origin xyz="0 0 0"
            rpy="0 1.57079632679 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="50"
        velocity="6.0"/>

    <dynamics
        damping="0.5"
        friction="0.05"/>

</joint>

<!-- ========================================================== -->
<!-- WRIST 2 -->
<!-- ========================================================== -->

<link name="link_5">

    <visual>

        <origin xyz="0 0 0"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.095"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0 0 0"/>

        <geometry>
            <cylinder radius="0.040"
                      length="0.095"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0 0 0"/>

        <mass value="0.90"/>

        <inertia
            ixx="0.00110"
            ixy="0"
            ixz="0"
            iyy="0.00110"
            iyz="0"
            izz="0.00075"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- WRIST 3 JOINT -->
<!-- ========================================================== -->

<joint name="joint_6"
       type="revolute">

    <parent link="link_5"/>
    <child link="link_6"/>

    <!-- Center-to-center spacing between Wrist 2 and Wrist 3 -->
    <origin xyz="0 0 0.095"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-3.14159"
        upper="3.14159"
        effort="40"
        velocity="6.28"/>

    <dynamics
        damping="0.35"
        friction="0.03"/>

</joint>

<!-- ========================================================== -->
<!-- WRIST 3 -->
<!-- ========================================================== -->

<link name="link_6">

    <visual>

        <origin xyz="0 0 0.041"/>

        <geometry>
            <cylinder radius="0.040"
                      length="0.082"/>
        </geometry>

        <material name="dark_gray"/>

    </visual>

    <collision>

        <origin xyz="0 0 0.041"/>

        <geometry>
            <cylinder radius="0.036"
                      length="0.082"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0 0 0.041"/>

        <mass value="0.80"/>

        <inertia
            ixx="0.00080"
            ixy="0"
            ixz="0"
            iyy="0.00080"
            iyz="0"
            izz="0.00055"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- FLANGE -->
<!-- ========================================================== -->

<joint name="flange_joint"
       type="fixed">

    <parent link="link_6"/>
    <child link="flange"/>

    <origin xyz="0 0 0.082"
            rpy="0 0 0"/>

</joint>

<link name="flange">

    <visual>

        <origin xyz="0 0 0.010"/>

        <geometry>
            <cylinder radius="0.045"
                      length="0.020"/>
        </geometry>

        <material name="light_gray"/>

    </visual>

    <collision>

        <origin xyz="0 0 0.010"/>

        <geometry>
            <cylinder radius="0.042"
                      length="0.020"/>
        </geometry>

    </collision>

    <inertial>

        <origin xyz="0 0 0.010"/>

        <mass value="0.30"/>

        <inertia
            ixx="0.00012"
            ixy="0"
            ixz="0"
            iyy="0.00012"
            iyz="0"
            izz="0.00009"/>

    </inertial>

</link>

<!-- ========================================================== -->
<!-- TOOL0 FRAME -->
<!-- ========================================================== -->

<joint name="tool_joint"
       type="fixed">

    <parent link="flange"/>
    <child link="tool0"/>

    <!-- Robot TCP reference frame -->
    <origin xyz="0 0 0.020"
            rpy="0 0 0"/>

</joint>

<link name="tool0"/>
</robot>
