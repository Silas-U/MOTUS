# PlanTrajectory.action
# Request: a run of motion legs
string[] leg_step_ids
geometry_msgs/Pose[] leg_target_poses
string[] leg_traj_methods
string[] leg_traj_types
float64[] leg_blend_radii
float64[] seed_state
float64 speed_scale
---
# Result
bool success
int32 error_code
trajectory_msgs/JointTrajectory trajectory
float64[] predicted_final_state
float64 total_duration
---
# Feedback (empty — planning is fast enough that progress isn't needed)
